# Cấu hình lệnh  npm run deploy  (scripts/deploy.mjs)
# Chép file này thành .env.deploy rồi điền – .env.deploy KHÔNG đưa vào git (chứa khoá bí mật).

# Địa chỉ API trên server (bỏ trống -> dùng VITE_API_BASE_URL trong .env)
DEPLOY_URL=https://apiweb.shopphanmem.io.vn

# Khoá cập nhật = Deploy:Key cấu hình trong appsettings.Production.json trên server
DEPLOY_KEY=

# File .csproj của API (dùng cho npm run deploy -- api)
DEPLOY_API_PROJECT=../API_App_Demo/API_App_Demo/API_App_Demo.csproj
