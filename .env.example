# Địa chỉ backend ASP.NET Core (dùng cho proxy khi chạy npm run dev)
VITE_API_TARGET=https://localhost:7001

# Base URL khi gọi API. Để trống = gọi qua proxy (/api/...).
# Khi build deploy khác domain thì điền đầy đủ, ví dụ: https://erp-api.congty.vn
VITE_API_BASE_URL=

# true = dùng dữ liệu giả trong src/api/mockData.js (không cần backend)
# false = gọi API thật
VITE_USE_MOCK=true

# Realtime (socket): mock = giả lập trong trình duyệt (mở 2 tab để thử) | signalr = hub SignalR thật | off = tắt
VITE_SOCKET_MODE=mock
# Đường dẫn hub SignalR (đi qua proxy /hubs khi dev)
VITE_SOCKET_HUB=/hubs/app
# Hub nằm chung API_App_Demo -> để trống (proxy /hubs đi cùng VITE_API_TARGET). Hub ở server khác -> điền địa chỉ server đó
VITE_SOCKET_TARGET=
# TEST: bản build (IIS) cũng gửi tài khoản kèm kết nối chat – dùng khi API bật Realtime:DevBypassToken (chưa có proc CP_RT_ValidateToken).
# Chạy thật đặt false (server lấy tài khoản từ TokenKey).
VITE_SOCKET_SEND_USER=false
